# Configuration Better Auth pour le déploiement
# URL de base pour Better Auth (nécessaire en production)
BETTER_AUTH_URL=https://votre-domaine-production.com

# Base de données PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database

# Google OAuth
GOOGLE_CLIENT_ID=votre_google_client_id
GOOGLE_CLIENT_SECRET=votre_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=votre_github_client_id
GITHUB_CLIENT_SECRET=votre_github_client_secret

# Port du serveur
PORT=8000

# Environnement
NODE_ENV=production

# URL du frontend (optionnel)
FRONTEND_URL=https://votre-frontend.com